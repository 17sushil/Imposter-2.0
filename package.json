{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "imposter-game",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer social deduction party game — Expo mobile app, Next.js web app, shared Node.js + Socket.IO backend.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @imposter-game/web run dev",
    "dev:mobile": "pnpm --filter @imposter-game/mobile run dev",
    "dev:server": "pnpm --filter @imposter-game/server run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rm -rf node_modules .next dist .expo"
  }
}
