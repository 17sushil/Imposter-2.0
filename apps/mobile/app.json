{
  "expo": {
    "name": "Imposter Game",
    "slug": "imposter-game",
    "version": "0.1.0",
    "icon": "./assets/icon/icon.png",
    "orientation": "portrait",
    "scheme": "impostergame",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0618",
    "splash": {
      "image": "./assets/backgrounds/fantasy-party-portrait-720.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#0B0618"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.impostergame.app"
    },
    "android": {
      "package": "com.impostergame.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#0B0618"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/icon/favicon.png"
    }
  }
}
