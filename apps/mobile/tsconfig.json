{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/game": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@shared/game/*": [
        "../../packages/shared-types/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "@shared/contract": [
        "../../packages/shared-types/src/contract.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
