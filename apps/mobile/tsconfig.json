{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/game": [
        "../../packages/shared-game/src/index.ts"
      ],
      "@shared/game/*": [
        "../../packages/shared-game/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
